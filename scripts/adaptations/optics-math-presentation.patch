diff --git a/test/math-presentation.test.js b/test/math-presentation.test.js
new file mode 100644
--- /dev/null
+++ b/test/math-presentation.test.js
@@ -0,0 +1,31 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import vm from 'node:vm';
+import {readFile} from 'node:fs/promises';
+
+const read=p=>readFile(new URL(p,import.meta.url),'utf8');
+
+test('optics SVG indices are proper local subscripts and keep ordinary labels unchanged',async()=>{
+ const code=await read('../dist/app.js');
+ const fn=code.match(/function svgScriptLabels\(value\) \{[\s\S]*?\n\}/)[0];
+ const render=vm.runInNewContext(fn+';svgScriptLabels');
+ assert.equal(render('O · 50 cm'),'O · 50 cm');
+ assert.equal(render('C₁/C₂'),'C<tspan baseline-shift="sub" font-size="75%">1</tspan>/C<tspan baseline-shift="sub" font-size="75%">2</tspan>');
+ assert.match(render('Fₚ'),/^F<tspan[^>]+>p<\/tspan>$/);
+});
+
+test('finite optics substitutions retain the signed Cartesian equation and existing fraction structure',async()=>{
+ const code=await read('../dist/app.js');
+ const block=code.match(/  if \(!optic.isPlane && image.kind !== 'infinity'\) \{[\s\S]*?\n  \}/)[0];
+ for(const isLens of [false,true]){
+  const host={innerHTML:'unchanged'};
+  vm.runInNewContext(block,{optic:{isPlane:false},image:{kind:'real'},isLens,c:{f:isLens?80:-80,x1:-160,x2:isLens?160:-160},signed:n=>String(n),$:()=>host});
+  assert.equal((host.innerHTML.match(/class="fraction"/g)||[]).length,3);
+  assert.ok(host.innerHTML.includes(isLens?' − ':' + '));
+  const denominators=[...host.innerHTML.matchAll(/<span>\(([-\d]+)\)<\/span>/g)].map(m=>Number(m[1]));
+  assert.deepEqual(denominators,isLens?[80,160,-160]:[-80,-160,-160]);
+ }
+ for(const [isPlane,kind]of [[true,'virtual'],[false,'infinity']]){
+  const host={innerHTML:'unchanged'};vm.runInNewContext(block,{optic:{isPlane},image:{kind},$:()=>host});assert.equal(host.innerHTML,'unchanged');
+ }
+});
